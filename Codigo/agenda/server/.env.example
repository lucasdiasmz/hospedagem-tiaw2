# Copie para .env e ajuste. Sem MONGODB_URI, os dados ficam em memória (carregados de Codigo/db/db.json).
# Porta 3002 para rodar junto com o backend da homepage (3001).
PORT=3002
# usuário usado quando a requisição não manda o cabeçalho X-Usuario-Id (enquanto não há login)
USUARIO_PADRAO=usr-1
# MONGODB_URI=mongodb://localhost:27017   (o mesmo banco da homepage)
# MONGODB_DB=acessamob
# DB_SEED=caminho/para/outro/db.json
